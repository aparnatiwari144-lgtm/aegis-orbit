# ==============================================================================
# AEGIS-ORBIT: Space Debris Detection & Collision Avoidance AI
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your credentials.
# NEVER commit real credentials to version control.

# Space-Track.org Credentials (free account at https://www.space-track.org)
# Leave empty and set ENABLE_SPACETRACK=false to run in CelesTrak-only mode
SPACETRACK_USERNAME=your_spacetrack_username
SPACETRACK_PASSWORD=your_spacetrack_password
ENABLE_SPACETRACK=false

# Database Configuration
DATABASE_URL=sqlite:///./aegis_orbit.db

# CelesTrak Fair-Use Configuration
CELESTRAK_USER_AGENT=AEGIS-Orbit-SpaceDebrisAI/1.0 (aerospace-research-prototype; contact: contact@aegis-orbit.local)
CELESTRAK_POLL_INTERVAL_HOURS=2

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO
